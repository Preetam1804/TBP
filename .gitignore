# IDE / Internal
.freebuff/

# Virtual Environment
.venv/
env/
venv/

# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Distribution / packaging
build/
dist/
*.egg-info/

# Logs
logs/
*.log

# Data: keep the directory skeleton, ignore every payload.
# `data/*` (not `data/`) is what makes the negations below effective: git does
# not descend into an excluded directory, so the parent must stay traversable.
data/*
!data/.gitkeep
!data/raw
!data/interim

data/raw/*
!data/raw/.gitkeep

data/interim/*
!data/interim/.gitkeep

data/outputs/
